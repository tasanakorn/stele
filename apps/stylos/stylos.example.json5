{
  stylos: {
    realm:    "dev",
    role:     "watcher",
    instance: "host-a-42",
  },
  zenoh: {
    mode: "peer",
    connect: {
      endpoints: [],
    },
    listen: {
      // Leave empty to let stylos pick a free port in [31747, 31755).
      // Or pin: ["udp/0.0.0.0:31747", "tcp/0.0.0.0:31747"]
      endpoints: [],
    },
    scouting: {
      multicast: {
        enabled:   true,
        address:   "224.0.0.224:31746",
        interface: "auto",
        autoconnect: { peer: "peer", router: "peer" },
      },
      gossip: { enabled: true },
    },
  },
}
